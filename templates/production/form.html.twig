{% extends is_modal_request() ? 'core/modal-form-base.html.twig' : 'base.html.twig' %}

{% import 'core/default_templates/form_table_macro.html.twig' as form_table %}

{% set is_edit = is_edit_route(app.request.get('_route')) %}
{% set form_btns = form_table.btns('production_list', form, is_edit) %}
{% set fields = form_table.generateFormRows(form) %}

{% set headerTitle = '' %}
{% if is_edit == false %}
    {% set headerTitle = 'production.createTitle'|dtrans %}
{% else %}
    {% set headerTitle = 'production.editTitle'|dtrans %}
{% endif %}

{% set formOptions = {
    'template': is_modal_request() ? 'core/default_templates/_form_modal.html.twig' : 'core/default_templates/_form.html.twig',
} %}

{% block body %}
    {% embed formOptions.template with formOptions %}
        {% block head_title %}
            {{ headerTitle }}
        {% endblock %}

        {% block form_fields %}
            {{ fields }}
        {% endblock %}

        {% block form_btns %}
            {{ form_btns }}
        {% endblock %}
    {% endembed %}

    {% if is_edit %}
        <div class="card mt-4">
            <div class="card-header">
                {{ 'production.materialsCardTitle'|dtrans }}
            </div>
            <div class="card-body">
                <div class="api-v1" data-url-list="{{ path('production_material_list', {'productionId': form.vars.data.id}) }}"></div>
            </div>
        </div>
    {% endif %}
{% endblock %} 